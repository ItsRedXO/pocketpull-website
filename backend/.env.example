# PostgreSQL — use either DATABASE_URL or the PG* variables below.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSL=true
PGSSLMODE=require
PGPOOL_MAX=20

# Existing authentication / provider credentials retained during transition.
BLINK_PROJECT_ID=
BLINK_SECRET_KEY=
BLINK_SERVER_SEED=

# Payment/email secrets used by existing routes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COINBASE_COMMERCE_API_KEY=
