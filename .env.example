# PostgreSQL (migration/local)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_me
PGDATABASE=pocketpull_migration
# DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/pocketpull_migration

# Blink remains authentication-only during the transition phase.
BLINK_PROJECT_ID=replace_me
BLINK_SECRET_KEY=replace_me

# Keep the provably-fair server seed secret outside source control.
BLINK_SERVER_SEED=replace_me

# Payment secrets stay server-side and are intentionally placeholders here.
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
COINBASE_COMMERCE_API_KEY=replace_me
COINBASE_COMMERCE_WEBHOOK_SECRET=replace_me
