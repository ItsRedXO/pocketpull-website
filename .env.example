# PostgreSQL application database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Public URL used by the browser for backend API/database proxy requests
VITE_BACKEND_URL=https://your-postgres-backend.example.com

# Blink remains the JWT authentication provider during migration
BLINK_PROJECT_ID=
BLINK_SECRET_KEY=

# Supabase Auth (Phase 1 of the Blink -> Supabase migration, running in parallel
# with Blink auth above; see backend/routes/authSupabase.ts). SUPABASE_URL is
# public, not a secret. SUPABASE_JWT_SECRET is only needed if this project
# uses legacy HS256-signed session tokens rather than the newer JWKS-based
# signing keys (verify during Phase 1 testing) -- it IS a real secret,
# found in Supabase Settings -> API -> JWT Settings.
SUPABASE_URL=https://etyeqpwxwuzdplptetwh.supabase.co
SUPABASE_JWT_SECRET=

# Phase 3: server-only Supabase Admin API access, used exclusively to
# silently create/link a Supabase identity for an existing account right
# after a successful Blink login (backend/lib/supabaseAdmin.ts). This is a
# REAL, highly privileged secret -- Supabase Settings -> API -> service_role
# key ("reveal"). Never expose to the frontend/browser.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4: frontend Supabase client, used to opportunistically establish a
# real session for accounts already linked (Phase 3) so the browser can
# start sending Supabase tokens instead of Blink ones (see
# src/lib/blink.ts getPreferredAuthToken()). Both values are public --
# the anon/publishable key is safe to expose in the browser bundle, unlike
# SUPABASE_SERVICE_ROLE_KEY above. Blink remains the fallback for every
# account without a live Supabase session.
VITE_SUPABASE_URL=https://etyeqpwxwuzdplptetwh.supabase.co
VITE_SUPABASE_ANON_KEY=

# Provably-fair server seed
BLINK_SERVER_SEED=

# Payment providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=
